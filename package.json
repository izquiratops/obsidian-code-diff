{
  "name": "obsidian-code-diff",
  "description": "Render code diffs embedded in the middle of your notes",
  "keywords": [
    "obsidian",
    "diff",
    "code",
    "git"
  ],
  "license": "MIT",
  "author": "Jordi Izquierdo <jordi.izquierdo@mailbox.org>",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx esbuild.config.mjs",
    "build": "tsx esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/*.test.ts\"",
    "install-plugin": "bash scripts/install.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@pierre/diffs": "^1.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "semver": "^7.8.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
